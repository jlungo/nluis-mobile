<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">



    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent"
        android:focusable="true" android:clickable="true"
        android:background="?android:attr/selectableItemBackground"
        android:weightSum="1"
        android:layout_height="wrap_content"
        xmlns:android="http://schemas.android.com/apk/res/android">



        <LinearLayout android:orientation="horizontal"
            android:layout_width="match_parent"
            android:focusable="true" android:clickable="true"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:weightSum="1" android:id="@+id/ln_root"
            android:layout_height="wrap_content">

            <TextView android:layout_weight="0.1" android:textSize="14sp"
                android:padding="@dimen/_4sdp"
                android:layout_width="0dp"
                android:id="@+id/txt_1" android:hint="no"
                android:layout_height="wrap_content"/>

            <View android:background="#efefef"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>

            <TextView android:layout_weight="0.6" android:textSize="14sp"
                android:id="@+id/txt_2" android:hint="NotificationNumber"
                android:padding="@dimen/_8sdp" android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>
            <View android:background="#efefef"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <TextView android:layout_weight="0.3" android:textSize="14sp"
                android:id="@+id/txt_3" android:hint="status"
                android:gravity="center" android:maxLines="1" android:ellipsize="end"
                android:padding="@dimen/_4sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content" />

            <TextView android:layout_weight="0.3" android:textSize="14sp"
                android:id="@+id/txt_4" android:hint="status"
                android:gravity="center" android:maxLines="1" android:ellipsize="end"
                android:padding="@dimen/_4sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

<!--            ADDING DELETE BUTTON-->
<!--            <Button-->
<!--                android:id="@+id/deleteButton"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="Delete" />-->

        </LinearLayout>

        <View android:background="#efefef"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>

    </LinearLayout>
</layout>