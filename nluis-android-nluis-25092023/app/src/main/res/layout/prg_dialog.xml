<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#fff"
    android:padding="20dp">

    <TextView android:id="@id/txt_title" android:text="Tafadhali Subiri...."
        android:layout_width="match_parent" android:textStyle="bold" android:layout_marginBottom="@dimen/_8sdp"
        android:layout_height="wrap_content" android:textSize="16sp"/>

    <ProgressBar android:id="@+id/prog_wait" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <RelativeLayout android:layout_marginTop="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_centerVertical="true"
            android:id="@+id/txt_wait"  android:textColor="@color/purple_200"
            android:layout_toLeftOf="@+id/btn_close" android:layout_margin="@dimen/_4sdp"
            android:text="Mfumo Unaunganishwa na Mfumo Mama"
            android:layout_toStartOf="@+id/btn_close" />

        <Button android:text="Ghairi" android:id="@+id/btn_close" android:textColor="#fff"
            android:layout_width="wrap_content" android:background="#f00"
            android:layout_height="wrap_content" android:layout_alignParentRight="true"/>
    </RelativeLayout>
</LinearLayout>