<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:paddingTop="@dimen/_1sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/_2sdp"
        android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="horizontal"
            android:layout_height="wrap_content">
            <TextView android:layout_width="100dp" android:textSize="24sp"
                android:gravity="center" android:background="@drawable/gradient"
                android:layout_height="match_parent" android:text="20"
                android:id="@+id/txt_no"
                android:textColor="#fff" android:textStyle="bold"/>

            <RelativeLayout android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_toLeftOf="@+id/vw" android:layout_marginRight="@dimen/_4sdp"
                    android:orientation="vertical" android:padding="@dimen/_8sdp"
                    android:layout_centerVertical="true"
                    android:layout_height="wrap_content">

                    <TextView android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="Dodoso"
                        android:textSize="18sp" android:textStyle="bold"
                        android:id="@+id/txt_title"/>
                    <TextView android:layout_width="match_parent" android:textColor="#aaa"
                        android:layout_height="wrap_content" android:text="Sample dodoso"
                        android:textSize="10sp" android:maxLines="2" android:ellipsize="end"
                        android:id="@+id/txt_descr"/>
                </LinearLayout>

                <ImageView android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:id="@+id/vw" android:layout_margin="@dimen/_8sdp"
                    android:src="@drawable/ic_baseline_more_vert_24"
                    android:layout_height="50dp"
                    android:layout_alignParentRight="true"/>


            </RelativeLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>