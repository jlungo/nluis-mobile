<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <RelativeLayout
        android:focusable="true" android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ccc">



        <View android:background="#efefef"
            android:id="@+id/top_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>




        <LinearLayout android:id="@+id/ln_title"
            android:orientation="horizontal"
            android:background="@drawable/bg_title"
            android:weightSum="1" android:layout_below="@id/top_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/ic_baseline_receipt_24">

            <TextView android:layout_weight="0.1" android:textSize="14sp"
                android:padding="@dimen/_4sdp"
                android:layout_width="0dp" android:fontFamily="@font/gilroy_bold"
                android:id="@+id/txt_1" android:text="No"
                android:layout_height="wrap_content"/>

            <View android:background="#efefef"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>

            <TextView android:layout_weight="0.6" android:textSize="14sp"
                android:fontFamily="@font/gilroy_bold"
                android:id="@+id/txt_2" android:hint="Unique ID"
                android:padding="@dimen/_8sdp" android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>
            <View android:background="#efefef"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <TextView android:layout_weight="0.3" android:textSize="14sp"
                android:id="@+id/txt_3" android:text="Status"
                android:fontFamily="@font/gilroy_bold"
                android:gravity="center" android:maxLines="1" android:ellipsize="end"
                android:padding="@dimen/_4sdp" android:drawableEnd="@drawable/ic_baseline_history_24"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>




        </LinearLayout>

        <EditText
            android:id="@+id/edt_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ln_title"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="#fff"
            android:drawableStart="@drawable/ic_baseline_search_24"
            android:drawablePadding="8dp"
            android:fontFamily="@font/gilroy_semibold"
            android:hint="Search"
            android:padding="10dp"
            android:textColorHint="#ccc" />

        <ProgressBar
            android:id="@+id/progress" android:layout_below="@id/edt_search"
            android:indeterminateDrawable="@android:drawable/progress_indeterminate_horizontal"
            android:minHeight="12dip"
            android:indeterminate="true"
            android:maxHeight="12dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginStart="@dimen/_4sdp"
            android:background="#fff"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_width="match_parent"
            android:id="@+id/recy" tools:listitem="@layout/vw_list"
            android:layout_below="@+id/progress"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
</layout>