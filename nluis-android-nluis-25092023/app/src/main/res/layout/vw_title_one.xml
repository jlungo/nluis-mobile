<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <variable
            name="summ"
            type="go.land.nluis.mvvm.model.Summary" />
    </data>
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical" android:paddingTop="@dimen/_4sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:id="@+id/crd"
            app:cardCornerRadius="0dp" android:layout_marginBottom="@dimen/_2sdp"
            android:layout_height="wrap_content">

            <LinearLayout android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <TextView android:layout_width="wrap_content"  android:textSize="12sp"
                    android:layout_gravity="center"
                    android:textColor="@color/purple_200" android:id="@+id/txt_card_title"
                    android:text="Ukasanywaji wa Taarifa" android:layout_marginTop="@dimen/_4sdp"
                    android:layout_height="wrap_content" android:layout_marginLeft="@dimen/_4sdp"/>

                <TextView android:layout_width="wrap_content" android:textColor="#aaa"
                    android:textSize="9sp" android:text="Idadi ya data zilizokusanywa"
                    android:layout_marginLeft="@dimen/_4sdp" android:id="@+id/txt_card_descrpt"
                    android:layout_height="wrap_content"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="@dimen/_4sdp" android:orientation="vertical"
                    android:id="@+id/rel_card" >


                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:background="#ddd"/>

                    <LinearLayout android:layout_width="match_parent" android:background="#fff"
                        android:orientation="horizontal" android:weightSum="3"
                        android:layout_height="wrap_content" android:gravity="center"
                        android:padding="@dimen/_4sdp">

                        <LinearLayout android:layout_width="0dp" android:gravity="center"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_height="match_parent"
                            android:background="?android:attr/selectableItemBackground"
                            android:id="@+id/btn1">
                            <TextView android:layout_width="wrap_content" android:textStyle="bold"
                                android:id="@+id/txt_plots" android:text="@{summ.leo}"
                                android:hint="0" android:textSize="@dimen/_18sdp" android:textColor="#f00"
                                android:layout_height="wrap_content"/>

                            <TextView android:layout_width="wrap_content" android:textColor="#aaa"
                                android:text="LEO" android:textSize="12sp"
                                android:layout_height="wrap_content"/>
                            <RatingBar  style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:isIndicator="true" android:backgroundTint="#000"
                                android:numStars="5" android:id="@+id/rt_bar_plots"
                                android:rating="3"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:progressTint="@color/purple_200"
                                android:secondaryProgressTint="#ccc"
                                android:stepSize="1.0"/>

                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:gravity="center"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_height="match_parent"
                            android:id="@+id/btn2"
                            android:background="?android:attr/selectableItemBackground">
                            <TextView android:layout_width="wrap_content" android:textStyle="bold"
                                android:id="@+id/txt_farms"  android:text="@{summ.jumla}"
                                android:hint="0" android:textSize="@dimen/_18sdp" android:textColor="@color/purple_200"
                                android:layout_height="wrap_content"/>

                            <TextView android:layout_width="wrap_content" android:textColor="#aaa"
                                android:text="JUMLA" android:textSize="12sp"
                                android:layout_height="wrap_content"/>
                            <RatingBar  style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:isIndicator="true" android:backgroundTint="#000"
                                android:numStars="5" android:id="@+id/rt_bar_farms"
                                android:rating="4.5"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:progressTint="@color/purple_200"
                                android:secondaryProgressTint="#ccc"
                                android:stepSize="1.0"/>

                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:gravity="center"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_height="match_parent"
                            android:id="@+id/btn3"
                            android:background="?android:attr/selectableItemBackground">
                            <TextView android:layout_width="wrap_content" android:textStyle="bold"
                                android:id="@+id/txt_others"  android:text="@{summ.zimetumwa}"
                                android:hint="1" android:textSize="@dimen/_18sdp" android:textColor="#080"
                                android:layout_height="wrap_content"/>

                            <TextView android:layout_width="wrap_content" android:textColor="#aaa"
                                android:text="VIMETUMWA" android:textSize="12sp"
                                android:layout_height="wrap_content"/>
                            <RatingBar  style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:rating="1"
                                android:isIndicator="true" android:backgroundTint="#000"
                                android:numStars="5" android:id="@+id/rt_bar_others"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:progressTint="@color/purple_200"
                                android:secondaryProgressTint="#ccc"
                                android:stepSize="1.0"/>

                        </LinearLayout>


                        <LinearLayout android:layout_width="0dp" android:gravity="center"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_height="match_parent"
                            android:id="@+id/btn4" android:visibility="gone"
                            android:background="#efeeef">

                            <TextView android:layout_width="wrap_content" android:textStyle="bold"
                                android:id="@+id/txt_all"
                                android:text="1" android:textSize="@dimen/_18sdp" android:textColor="#008"
                                android:layout_height="wrap_content"/>

                            <TextView android:layout_width="wrap_content" android:textColor="#aaa"
                                android:text="KANZI DATA" android:textSize="12sp"
                                android:id="@+id/txt_kanzidata"
                                android:layout_height="wrap_content"/>
                            <RatingBar  style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:rating="1"
                                android:isIndicator="true" android:backgroundTint="#000"
                                android:numStars="5" android:id="@+id/rt_bar_all"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:progressTint="@color/purple_200"
                                android:secondaryProgressTint="#ccc"
                                android:stepSize="1.0"/>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>


        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/crd"
            android:background="#efefef"
            android:gravity="center"
            android:paddingLeft="@dimen/_4sdp"
            android:paddingTop="@dimen/_4sdp"
            android:paddingBottom="@dimen/_4sdp"
            android:text="Yafuatayao ni Madodoso yanayotakiwa kujazwa"
            android:textColor="@color/purple_200"
            android:textSize="10sp" />

    </RelativeLayout>
</layout>