<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".mvvm.views.activity.MapUtambuziActivity">


        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/mn_edit"
            android:layout_marginBottom="@dimen/_minus60sdp" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tb"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/purple_500"
            android:theme="@style/ThemeOverlay.AppCompat.Dark" />


        <LinearLayout android:orientation="horizontal" android:background="#fff"
            android:layout_width="match_parent" android:weightSum="2" android:layout_below="@+id/tb"
            android:layout_height="wrap_content" android:id="@+id/mn_chukua" >

            <TextView android:textStyle="bold" android:textColor="@color/purple_500"
                android:gravity="center" android:id="@+id/btn_chora"
                android:clickable="true" android:focusable="true"
                android:textSize="@dimen/_14sdp"
                android:layout_width="0dp" android:layout_weight="1" android:text="Chora Umbo"
                android:layout_height="wrap_content" android:padding="@dimen/_6sdp" />

            <View android:background="#efefef"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>

            <TextView android:textStyle="bold"  android:textColor="@color/purple_500"
                android:layout_width="0dp" android:layout_weight="1" android:text="Nasa Umbo kwa GPS"
                android:layout_height="wrap_content" android:padding="@dimen/_6sdp"
                android:clickable="true" android:focusable="true"
                android:textSize="@dimen/_14sdp"
                android:gravity="center" android:id="@+id/btn_chukua"/>

        </LinearLayout>

        <include android:visibility="gone"
            android:id="@+id/mn_edit"
            layout="@layout/mn_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/mn_chukua" />


        <Button android:visibility="gone"
            android:id="@+id/btn_nilipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginLeft="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:background="@drawable/btn"
            android:text="Chukua Nilipo"
            android:textColor="#fff" />

    </RelativeLayout>
</layout>