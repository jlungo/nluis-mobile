<?xml version="1.0" encoding="utf-8"?>
<layout>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:focusableInTouchMode="true"
        android:focusable="true"
        android:layout_height="match_parent"
        tools:context=".MapActivity">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/mn_edit"
            android:layout_marginBottom="@dimen/_minus60sdp" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tb"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/purple_200"
            android:theme="@style/ThemeOverlay.AppCompat.Dark">
            <View android:layout_gravity="end" android:id="@+id/vw"
                android:layout_width="@dimen/_1sdp"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.Toolbar>

        <LinearLayout android:orientation="horizontal" android:background="#fff"
            android:layout_width="match_parent" android:weightSum="2" android:layout_below="@+id/tb"
            android:layout_height="wrap_content" android:id="@+id/mn_chukua" >

            <TextView
                android:id="@+id/btn_chora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/_6sdp"
                android:text="Donoa Ramani"
                android:textColor="@color/purple_200"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold" />

            <View android:background="#efefef"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>

            <TextView android:textStyle="bold"  android:textColor="@color/purple_200"
                android:layout_width="0dp" android:layout_weight="1" android:text="GPS ya Simu"
                android:layout_height="wrap_content" android:padding="@dimen/_6sdp"
                android:clickable="true" android:focusable="true"
                android:textSize="@dimen/_14sdp"
                android:gravity="center" android:id="@+id/btn_chukua"/>

        </LinearLayout>



        <include layout="@layout/mn_edit" android:visibility="gone"
            android:layout_below="@+id/mn_chukua"
            android:id="@+id/mn_edit" android:layout_width="match_parent" android:layout_height="wrap_content"/>






        <LinearLayout android:orientation="horizontal" android:layout_alignParentBottom="true"
            android:layout_width="match_parent" android:visibility="gone"
            android:layout_margin="@dimen/_8sdp" android:id="@+id/ln_nilipo_baadae"
            android:weightSum="2"
            android:layout_height="wrap_content">

            <Button  android:id="@+id/btn_nilipo"
                android:background="@drawable/btn_2" android:text="Chukua Nilipo"
                android:fontFamily="@font/gilroy_bold" android:textAllCaps="false"
                android:layout_marginEnd="@dimen/_2sdp"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <Button  android:id="@+id/btn_baadae"
                android:background="@drawable/btn_2" android:text="Endelea Baadae"
                android:fontFamily="@font/gilroy_bold" android:textAllCaps="false"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"/>


        </LinearLayout>

        <Button android:layout_margin="@dimen/_8sdp" android:id="@+id/btn_done_edit"
            android:background="@drawable/btn_2" android:text="Maliza Edit" android:layout_alignParentBottom="true"
            android:textColor="#fff" android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>



        <ProgressBar android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:id="@+id/prog" android:visibility="gone"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
</layout>